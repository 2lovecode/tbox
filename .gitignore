# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# npm lockfile — this project uses pnpm (pnpm-lock.yaml) as the single source
# of truth; keep `npm install` from silently reintroducing a second lockfile.
package-lock.json

# Project-local pnpm store (created when the default global store is not
# writable, e.g. sandboxed install — keep out of the repo).
.pnpm-store/

# Editor directories and files
.vscode
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri
/target/

# Windows reserved names
nul
CON
PRN
AUX
CLOCK$
NUL
COM1 COM2 COM3 COM4 COM5 COM6 COM7 COM8 COM9
LPT1 LPT2 LPT3 LPT4 LPT5 LPT6 LPT7 LPT8 LPT9

# Local AI tooling — agent skills/commands, not committed (like .cursor/)
.claude/
.agents/

# Cursor: local only（rules/commands/skills 本机生成，不进 git）
.cursor/

# Documentation (keep only important ones)
IMPROVEMENTS.md
IMPLEMENTATION_SUMMARY.md

# Sandbox-local CARGO_HOME (created when cargo check runs with escalated
# sandbox permissions and CARGO_HOME pointed at the repo root).
/.cargo/

# Git worktrees (Superpowers isolated workspaces)
.worktrees/
